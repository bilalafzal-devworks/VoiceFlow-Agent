# Copy this file to .env and fill in your own values. NEVER commit .env.
GROQ_API_KEY=your_groq_key_here
HF_TOKEN=your_huggingface_token_here
N8N_WEBHOOK_URL=https://your-n8n-host/webhook/voiceflow
DEFAULT_RECIPIENT_EMAIL=you@gmail.com

# Optional overrides (defaults shown)
# GROQ_MODEL=openai/gpt-oss-120b
# WHISPER_MODEL=whisper-large-v3
# PROMPT_VERSION=v2
# EMBEDDING_BACKEND=hf_api      # or "local"
# CHUNK_TOKENS=800              # try 200 for better MiniLM retrieval
# CHUNK_OVERLAP_TOKENS=100
# TOP_K=4
# MAX_REVISIONS=2
